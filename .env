# ─── CINE 360 environment ─────────────────────────────────────────
# Database (SQLite for the sandbox demo; use PostgreSQL in production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Auth — JWT signing secret (CHANGE IN PRODUCTION)
AUTH_SECRET=change-me-to-a-long-random-string

# Seat hold TTL in seconds (default 300 = 5 minutes)
HOLD_TTL_SECONDS=300

# Demo payment gateway signing secret (TEST MODE only)
DEMO_PAYMENT_SECRET=cine360-demo-gateway-secret

# Realtime hub (mini-services/realtime-hub)
REALTIME_HUB_URL=http://127.0.0.1:3004
HUB_SOCKET_PORT=3003
HUB_HTTP_PORT=3004

# Razorpay (leave unset to use the clearly-labelled DEMO payment mode)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
