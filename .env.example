# Database Connection URL (SQLite for local sandbox demo)
DATABASE_URL="file:./db/custom.db"

# Realtime Hub URL (Default: http://127.0.0.1:3004)
REALTIME_HUB_URL="http://127.0.0.1:3004"
HUB_SOCKET_PORT=3003
HUB_HTTP_PORT=3004

# Auth & Security
AUTH_SECRET="cine360-demo-secret-change-in-production"
DEMO_PAYMENT_SECRET="cine360-demo-gateway-secret"
HOLD_TTL_SECONDS=300

# Razorpay (Optional - switches from DEMO gateway to Live Razorpay)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
