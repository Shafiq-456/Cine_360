# ==============================================================================
# CINE 360 — Environment Variables Template
# Experience Your Seat Before You Book.
# ==============================================================================

# Database Connection URL (PostgreSQL for production, or SQLite for local dev)
# Example: postgresql://postgres:password@localhost:5432/cine360?schema=public
DATABASE_URL=""

# Realtime WebSocket & SSE Hub Configuration
REALTIME_HUB_URL=""
HUB_SOCKET_PORT=3003
HUB_HTTP_PORT=3004

# Session & Hold TTL Security
AUTH_SECRET=""
DEMO_PAYMENT_SECRET=""
HOLD_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Firebase Authentication — Client-side Web SDK (Public)
# Required for Google Sign-In, Email/Password login, and client auth state
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# Firebase Admin SDK — Server-side Token Verification (Private / Secret)
# Used to verify Firebase ID tokens in protected backend API routes
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# Payment Gateway (Optional: live Razorpay integration)
# When omitted, CINE 360 uses the built-in deterministic Instant Simulator
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
